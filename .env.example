# Porta em que a API escuta
PORT=3000

# Ambiente de execução (development, test ou production)
NODE_ENV=development

# Origens permitidas no CORS, separadas por vírgula
ALLOWED_ORIGINS=http://localhost:5173,https://seu-painel.vercel.app

# ID do projeto Firebase
FIREBASE_PROJECT_ID=seu_project_id_aqui

# Chave de API pública do Firebase (cliente web)
FIREBASE_API_KEY=sua_api_key_aqui

# Domínio de autenticação do Firebase
FIREBASE_AUTH_DOMAIN=seu_project.firebaseapp.com

# Bucket do Firebase Storage
FIREBASE_STORAGE_BUCKET=seu_bucket.firebasestorage.app

# Credencial da conta de serviço em JSON (uma linha). Use este campo OU o caminho do arquivo abaixo.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"seu_project_id_aqui","private_key_id":"sua_chave_aqui","private_key":"-----BEGIN PRIVATE KEY-----\nsua_chave_privada_aqui\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk@seu_project_id_aqui.iam.gserviceaccount.com"}

# Caminho alternativo para o arquivo JSON da conta de serviço (não commitar o arquivo)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Tamanho máximo de cada arquivo enviado, em megabytes
UPLOAD_MAX_FILE_SIZE_MB=5

# Quantidade máxima de arquivos por envio
UPLOAD_MAX_FILES=10

# Identificador do tenant usado quando nenhum outro é informado
DEFAULT_TENANT_ID=default
